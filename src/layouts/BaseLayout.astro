---
interface Props {
  title?: string;
  description?: string;
}

import { ISSUE } from '../lib/entries';

const {
  title = 'Implementors',
  description = ISSUE.lede,
} = Astro.props;
const pageTitle = title === 'Implementors' ? `${title} · ${ISSUE.label}` : `${title} · Implementors`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,600;0,700;1,400&family=Newsreader:opsz,wght@6..72,500;6..72,600;6..72,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <div class="masthead-brand">
          <a class="brand" href="/">Implementors</a>
          <p class="brand-line">{ISSUE.brandLine}</p>
        </div>
        <p class="masthead-meta">{ISSUE.volLabel}</p>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>Implementors</strong>
          <span aria-hidden="true"> · </span>
          {ISSUE.volLabel}
        </p>
        <p class="brand-line">{ISSUE.brandLine}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #2a2a28;
    --muted: #5c5a54;
    --line: #d4cdc0;
    --paper: #f3ede3;
    --paper-deep: #ebe4d6;
    --panel: #faf6ee;
    --accent: #1f4d3a;
    --accent-soft: #d7e4dc;
    --gold: #a68b4b;
    --sans: 'Libre Franklin', 'Segoe UI', sans-serif;
    --serif: 'Newsreader', 'Source Serif 4', Georgia, serif;
    --measure: 40rem;
    --page: 44rem;
    --page-wide: 72rem;
    --toc-width: 15rem;
    --art-max: 26rem;
    --masthead-sticky: 5.25rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    font-family: var(--sans);
    color: var(--ink);
    background:
      radial-gradient(900px 420px at 8% -5%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 55%),
      linear-gradient(180deg, var(--paper) 0%, var(--paper-deep) 100%);
    line-height: 1.65;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: white;
    padding: 0.5rem 0.75rem;
  }

  .wrap {
    width: min(100% - 2.5rem, var(--page));
    margin-inline: auto;
  }

  .wrap-wide {
    width: min(100% - 2.5rem, var(--page-wide));
    margin-inline: auto;
  }

  .issue-shell {
    display: grid;
    grid-template-columns: minmax(12rem, var(--toc-width)) minmax(0, 1fr);
    gap: 1.75rem 2.5rem;
    align-items: start;
    padding-top: 1.5rem;
  }

  .issue-main {
    min-width: 0;
  }

  .toc-rail {
    position: sticky;
    top: var(--masthead-sticky);
    z-index: 4;
    max-height: calc(100vh - var(--masthead-sticky) - 1rem);
    overflow: auto;
    align-self: start;
  }

  .toc-panel {
    margin: 0;
    padding: 0.65rem 0.85rem 0.85rem;
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    border: 1px solid var(--line);
    border-top: 2px solid var(--ink);
  }

  .toc-summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    padding: 0.2rem 0 0.55rem;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-summary::after {
    content: ' ▾';
    font-size: 0.85em;
    color: var(--gold);
  }

  .toc-panel:not([open]) .toc-summary::after {
    content: ' ▸';
  }

  @media (max-width: 63.99rem) {
    .issue-shell {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 1rem;
    }

    .toc-rail {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  .masthead {
    border: 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    box-shadow: 0 3px 0 -1px var(--paper), 0 4px 0 -1px var(--ink);
    background: color-mix(in srgb, var(--panel) 92%, transparent);
    backdrop-filter: blur(6px);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 1rem 0;
  }

  .masthead-brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.55rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-line {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }

  .masthead-meta {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  main {
    padding-bottom: 3.5rem;
  }

  h1,
  h2,
  h3,
  .piece-title {
    font-family: var(--serif);
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(1.55rem, 2.5vw, 1.9rem);
    margin: 0 0 0.65rem;
  }

  h3 {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-family: var(--sans);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  p.lede {
    max-width: var(--measure);
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0 0 1.75rem;
    line-height: 1.55;
  }

  .issue-head {
    padding: 1.75rem 0 1.25rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    box-shadow: 0 3px 0 -1px var(--paper), 0 4px 0 -1px var(--ink);
    margin-bottom: 1.75rem;
  }

  .issue-head .brand-line {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }

  .issue-head .lede {
    max-width: 38rem;
    margin-bottom: 1.15rem;
  }

  .issue-plate {
    margin: 0;
    max-width: min(100%, 28rem);
    background: var(--paper-deep);
  }

  .issue-plate img {
    display: block;
    width: 100%;
    max-width: 28rem;
    max-height: 11rem;
    height: auto;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--line);
  }

  .issue-kicker {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }

  .toc {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li {
    border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }

  .toc li:first-child {
    border-top: 0;
  }

  .toc a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0;
    text-decoration: none;
    color: inherit;
  }

  .toc a:hover .toc-title,
  .toc a:focus-visible .toc-title {
    color: var(--accent);
  }

  .toc li.current a {
    background: color-mix(in srgb, var(--accent-soft) 55%, transparent);
    margin-inline: -0.35rem;
    padding-inline: 0.35rem;
  }

  .toc li.current .toc-title {
    color: var(--accent);
  }

  .toc-title {
    font-family: var(--serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .toc-section {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .issue-section-label {
    margin: 2.75rem 0 1.25rem;
    padding-top: 0.5rem;
    border-top: 2px solid var(--ink);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 700;
  }

  .piece {
    max-width: none;
    margin: 0 0 3.25rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .piece:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }

  .piece-header {
    max-width: 40rem;
  }

  .piece-art {
    margin: 0 0 1.25rem;
    max-width: var(--art-max);
    width: 100%;
  }

  .piece-art img {
    display: block;
    width: 100%;
    max-width: var(--art-max);
    height: auto;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .piece-art figcaption {
    margin: 0.55rem 0 0;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-style: italic;
    color: var(--muted);
    line-height: 1.4;
    max-width: var(--art-max);
  }

  .piece-kicker {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }

  .piece-title {
    margin: 0 0 0.65rem;
    font-size: clamp(1.55rem, 2.5vw, 1.95rem);
  }

  .piece-title a {
    color: inherit;
    text-decoration: none;
  }

  .piece-title a:hover,
  .piece-title a:focus-visible {
    color: var(--accent);
  }

  .piece-dek {
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 500;
  }

  .piece-pull {
    margin: 0 0 1.35rem;
    padding: 0.85rem 0 0.85rem 1rem;
    border-left: 3px double var(--ink);
    border-top: none;
    border-bottom: none;
    border-right: none;
    max-width: 36rem;
  }

  .piece-pull p {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--ink);
  }

  .prose {
    max-width: none;
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 500;
  }

  .piece-body.prose {
    columns: 2;
    column-gap: 1.85rem;
    column-fill: balance;
  }

  .piece-body.prose p {
    orphans: 3;
    widows: 3;
  }

  @media (max-width: 52rem) {
    .piece-body.prose {
      columns: 1;
    }
  }

  .prose p {
    margin: 0 0 1rem;
  }

  .prose a {
    color: var(--accent);
  }

  .prose strong {
    font-weight: 700;
  }

  .piece-sources {
    margin-top: 1.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .piece-sources ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .piece-sources li {
    margin: 0.35rem 0;
    font-size: 0.88rem;
    word-break: break-word;
  }

  .piece-sources a {
    color: var(--muted);
  }

  .piece-sources a:hover,
  .piece-sources a:focus-visible {
    color: var(--accent);
  }

  .site-footer {
    padding: 1.5rem 0 2.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer strong {
    font-family: var(--serif);
    color: var(--ink);
    font-weight: 600;
  }

  .back-link {
    display: inline-block;
    margin: 0 0 1.5rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--accent);
  }

  .solo {
    padding: 2rem 0 0;
  }
</style>
