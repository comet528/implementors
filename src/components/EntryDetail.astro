---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

type AnyEntry =
  | CollectionEntry<'cards'>
  | CollectionEntry<'diffs'>
  | CollectionEntry<'lab'>;

interface Props {
  entry: AnyEntry;
  showAbstract?: boolean;
}

const { entry, showAbstract = false } = Astro.props;
const { Content } = await render(entry);
const body = entry.body?.trim() ?? '';
// First non-heading paragraph as a light abstract for cards.
const abstract =
  showAbstract
    ? body
        .split('\n')
        .map((l) => l.trim())
        .filter((l) => l && !l.startsWith('#') && !l.startsWith('---'))
        .slice(0, 1)[0] ?? ''
    : '';
---

<header>
  <p class="meta">
    <span class="chip">{entry.data.family}</span>
    <span>updated {entry.data.updated.toISOString().slice(0, 10)}</span>
  </p>
  <h1>{entry.data.title}</h1>
</header>

{
  showAbstract && abstract && (
    <p class="lede">{abstract}</p>
  )
}

<article class="prose">
  <Content />
</article>

{
  entry.data.sources.length > 0 && (
    <section class="sources prose">
      <h2>Sources</h2>
      <ul>
        {entry.data.sources.map((url) => (
          <li>
            <a href={url} rel="noopener noreferrer">
              {url}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
