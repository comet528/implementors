---
import type { CollectionEntry } from 'astro:content';
import { entryHref } from '../lib/entries';

type AnyEntry =
  | CollectionEntry<'spine'>
  | CollectionEntry<'cards'>
  | CollectionEntry<'diffs'>
  | CollectionEntry<'lab'>;

interface Props {
  entries: AnyEntry[];
  collection: 'spine' | 'cards' | 'diffs' | 'lab';
}

const { entries, collection } = Astro.props;
---

<ul class="entry-list">
  {
    entries.map((entry) => (
      <li>
        <a href={entryHref(collection, entry.data.slug)}>
          <p class="title">{entry.data.title}</p>
          <p class="sub">
            {entry.data.status}
            {entry.data.spine ? ' · spine' : ''}
            {' · '}
            {entry.data.family}
          </p>
        </a>
      </li>
    ))
  }
</ul>
