---
import type { CollectionEntry } from 'astro:content';
import { entryHref } from '../lib/entries';

type AnyEntry =
  | CollectionEntry<'cards'>
  | CollectionEntry<'diffs'>
  | CollectionEntry<'lab'>;

interface Props {
  entries: AnyEntry[];
  collection: 'cards' | 'diffs' | 'lab';
}

const { entries, collection } = Astro.props;
---

<ul class="entry-list">
  {
    entries.map((entry) => {
      const unfinished = entry.data.status === 'stub';
      return (
        <li class:list={{ stub: unfinished }}>
          <a href={entryHref(collection, entry.data.slug)}>
            <p class="title">{entry.data.title}</p>
            <p class="sub">{unfinished ? 'Unfinished — heading only' : 'Note'}</p>
          </a>
        </li>
      );
    })
  }
</ul>
