---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryDetail from '../../components/EntryDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('spine');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('spine', id);
if (!entry) {
  throw new Error(`Missing spine entry: ${id}`);
}
---

<BaseLayout title={entry.data.title} description={entry.data.fcs_evolution}>
  <EntryDetail entry={entry} />
</BaseLayout>
