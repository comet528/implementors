---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { byUpdatedDesc } from '../../lib/entries';

const entries = (await getCollection('lab')).sort(byUpdatedDesc);
---

<BaseLayout title="Lab" description="Public lab instruments only.">
  <h1>Lab</h1>
  <p class="lede">
    Public instruments only (suite/discovery/manifests, Framework/Lab listings). No as-run hop
    scores. No UK/KSA FCS-as-run files. Public instrument leaves live under <code>/lab</code> or
    <code>/cards</code> — there is no <code>/fcs/*</code> route.
  </p>
  <EntryList entries={entries} collection="lab" />
</BaseLayout>
