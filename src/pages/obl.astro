---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'obl')).sort(
  byUpdatedDesc,
);
---

<BaseLayout
  title="Open Banking Limited"
  description="Notes that cite OBL public materials."
>
  <h1>Open Banking Limited</h1>
  <p class="lede">Notes that cite Open Banking Limited public materials.</p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
