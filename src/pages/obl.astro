---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'obl')).sort(
  byUpdatedDesc,
);
---

<BaseLayout title="OBL" description="Open Banking Limited family cards.">
  <h1>OBL</h1>
  <p class="lede">Open Banking Limited public positioning cards.</p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
