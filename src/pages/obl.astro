---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'obl')).sort(
  byUpdatedDesc,
);
---

<BaseLayout
  title="What Open Banking Limited has said"
  description="What OBL has published — and has not. There is still no UK standard for AI-driven payments."
>
  <h1>What Open Banking Limited has said</h1>
  <p class="lede">
    What OBL has published, and what it has not. There is still no UK standard for AI-driven
    payments.
  </p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
