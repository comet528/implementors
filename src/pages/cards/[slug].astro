---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Piece from '../../components/Piece.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cards');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('cards', id);
if (!entry) {
  throw new Error(`Missing cards entry: ${id}`);
}
---

<BaseLayout title={entry.data.title} description={entry.data.title}>
  <div class="wrap solo">
    <a class="back-link" href="/">← Issue 1</a>
    <Piece entry={entry} collection="cards" />
  </div>
</BaseLayout>
