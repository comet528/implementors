---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Piece from '../../components/Piece.astro';
import TocRail from '../../components/TocRail.astro';
import { loadIssuePieces } from '../../lib/issue';

export async function getStaticPaths() {
  const entries = await getCollection('cards');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('cards', id);
if (!entry) {
  throw new Error(`Missing cards entry: ${id}`);
}

const { pieces } = await loadIssuePieces();
const description = entry.data.dek ?? entry.data.title;
---

<BaseLayout title={entry.data.title} description={description}>
  <div class="wrap-wide issue-shell">
    <TocRail pieces={pieces} currentSlug={entry.data.slug} />
    <div class="issue-main solo">
      <a class="back-link" href="/">← Issue 1</a>
      <Piece entry={entry} collection="cards" />
    </div>
  </div>
</BaseLayout>
