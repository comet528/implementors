---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { byUpdatedDesc } from '../../lib/entries';

const entries = (await getCollection('diffs')).sort(byUpdatedDesc);
---

<BaseLayout title="Diffs" description="Protocol and flow differences for implementors.">
  <h1>Diffs</h1>
  <p class="lede">Protocol and flow differences implementors need to choose between.</p>
  <EntryList entries={entries} collection="diffs" />
</BaseLayout>
