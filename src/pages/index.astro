---
import BaseLayout from '../layouts/BaseLayout.astro';
import Piece from '../components/Piece.astro';
import TocRail from '../components/TocRail.astro';
import { ISSUE } from '../lib/entries';
import { loadIssuePieces } from '../lib/issue';

const { pieces, features, labs } = await loadIssuePieces();
---

<BaseLayout title="Implementors" description={ISSUE.lede}>
  <div class="wrap-wide issue-shell">
    <TocRail pieces={pieces} />

    <div class="issue-main">
      <header class="issue-head">
        <p class="issue-kicker">{ISSUE.volLabel}</p>
        <h1>Implementors</h1>
        <p class="brand-line">{ISSUE.brandLine}</p>
        <p class="lede">{ISSUE.lede}</p>
        <figure class="issue-plate">
          <img
            src="/issue-1/hero.webp"
            alt=""
            width="1600"
            height="1067"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </header>

      <p class="issue-section-label">Features</p>
      {features.map(({ entry, collection }) => <Piece entry={entry} collection={collection} nested />)}

      <p class="issue-section-label">Lab notes</p>
      {labs.map(({ entry, collection }) => <Piece entry={entry} collection={collection} nested />)}
    </div>
  </div>
</BaseLayout>
