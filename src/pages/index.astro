---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const cards = (await getCollection('cards')).sort(byUpdatedDesc);
const diffs = (await getCollection('diffs')).sort(byUpdatedDesc);
const lab = (await getCollection('lab')).sort(byUpdatedDesc);

const doors = [
  {
    href: '/fapi/',
    label: 'API security',
    blurb: 'FAPI profiles, OIDF conformance, AuthZEN/CoAZ, and related notes.',
  },
  {
    href: '/obl/',
    label: 'Open Banking Limited',
    blurb: 'Notes that cite OBL public materials.',
  },
  {
    href: '/hmt/',
    label: 'HM Treasury',
    blurb: 'Consultation questions on agentic payments, consent, and liability.',
  },
  {
    href: '/lab/',
    label: 'Lab instruments',
    blurb: 'Published suites, attacker models, and framework listings.',
  },
  {
    href: '/diffs/',
    label: 'Diffs',
    blurb: 'Protocol and flow differences implementors need to choose between.',
  },
];
---

<BaseLayout
  title="Implementors"
  description="Public notes on open-banking and open-finance standards for implementors."
>
  <h1>Implementors</h1>
  <p class="lede">
    Public notes on open-banking and open-finance standards for implementors.
  </p>

  <h2>Start here</h2>
  <div class="family-grid">
    {
      doors.map((d) => (
        <a href={d.href}>
          <strong>{d.label}</strong>
          <span>{d.blurb}</span>
        </a>
      ))
    }
  </div>

  <h2>Notes</h2>
  <EntryList entries={cards} collection="cards" />

  <h2>Lab instruments</h2>
  <EntryList entries={lab} collection="lab" />

  <h2>Diffs</h2>
  <EntryList entries={diffs} collection="diffs" />
</BaseLayout>
