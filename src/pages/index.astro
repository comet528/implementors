---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const cards = (await getCollection('cards')).sort(byUpdatedDesc);
const diffs = (await getCollection('diffs')).sort(byUpdatedDesc);
const lab = (await getCollection('lab')).sort(byUpdatedDesc);

const doors = [
  {
    href: '/fapi/',
    label: 'How API security works',
    blurb:
      'UK open banking still reads FAPI 1 Advanced. Do not treat FAPI 2 as the UK rulebook.',
  },
  {
    href: '/obl/',
    label: 'What Open Banking Limited has said',
    blurb:
      'What OBL has published — and has not. There is still no UK standard for AI-driven payments.',
  },
  {
    href: '/hmt/',
    label: 'Treasury questions',
    blurb: 'Can software pay? Who consented? Who is liable if it goes wrong?',
  },
  {
    href: '/fapi/',
    label: 'Threat: the agent is not the customer',
    blurb:
      'A piece of software is not the person. Put the mandate on the account first.',
  },
  {
    href: '/lab/',
    label: 'Public test kits',
    blurb:
      'UK FCS, KSA listings, mock banks. The published suite — never a scored lab run.',
  },
];
---

<BaseLayout
  title="Implementors"
  description="A notebook for people who implement open-banking and open-finance APIs."
>
  <h1>Implementors</h1>
  <p class="lede">
    This is a notebook for people who implement open-banking and open-finance APIs. It is not a
    product. It is not a shop.
  </p>

  <h2>Start here</h2>
  <div class="family-grid">
    {
      doors.map((d) => (
        <a href={d.href}>
          <strong>{d.label}</strong>
          <span>{d.blurb}</span>
        </a>
      ))
    }
  </div>

  <h2>Notes</h2>
  <p class="lede">
    A filled card is a real note. An unfinished one is empty on purpose — heading only, no body yet.
  </p>
  <EntryList entries={cards} collection="cards" />

  <h2>Public test kits</h2>
  <EntryList entries={lab} collection="lab" />

  <h2>What changed between versions</h2>
  <EntryList entries={diffs} collection="diffs" />
</BaseLayout>
