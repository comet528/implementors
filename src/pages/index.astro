---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const spine = (await getCollection('spine')).sort(byUpdatedDesc);
const cards = (await getCollection('cards')).sort(byUpdatedDesc);
const diffs = (await getCollection('diffs')).sort(byUpdatedDesc);
const lab = (await getCollection('lab')).sort(byUpdatedDesc);

const families = [
  { href: '/fapi/', label: 'FAPI', blurb: 'Profiles, OIDF conformance, AuthZEN/CoAZ, AIIM.' },
  { href: '/obl/', label: 'OBL', blurb: 'Open Banking Limited public positioning.' },
  { href: '/hmt/', label: 'HMT', blurb: 'Treasury consultation and KYA/M2M framing.' },
  { href: '/lab/', label: 'Lab', blurb: 'Public instruments only — never as-run.' },
  { href: '/diffs/', label: 'Diffs', blurb: 'Protocol diffs implementors need to choose.' },
];
---

<BaseLayout title="Implementors" description="Public open-finance implementor directory.">
  <h1>Implementors</h1>
  <p class="lede">
    Public directory of spine cards, family cards, diffs, and lab instruments for open-finance
    implementors. Collections: <code>spine</code>, <code>cards</code>, <code>diffs</code>,
    <code>lab</code> only.
  </p>

  <h2>Spine</h2>
  <p class="lede">Entries with <code>spine: true</code> — start here.</p>
  <EntryList entries={spine} collection="spine" />

  <h2>Families</h2>
  <div class="family-grid">
    {
      families.map((f) => (
        <a href={f.href}>
          <strong>{f.label}</strong>
          <span>{f.blurb}</span>
        </a>
      ))
    }
  </div>

  <h2>All cards</h2>
  <EntryList entries={cards} collection="cards" />

  <h2>Lab instruments</h2>
  <EntryList entries={lab} collection="lab" />

  <h2>Diffs</h2>
  <EntryList entries={diffs} collection="diffs" />
</BaseLayout>
