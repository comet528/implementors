---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'hmt')).sort(
  byUpdatedDesc,
);
---

<BaseLayout
  title="Treasury questions"
  description="Can software pay? Who consented? Who is liable if it goes wrong?"
>
  <h1>Treasury questions</h1>
  <p class="lede">Can software pay? Who consented? Who is liable if it goes wrong?</p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
