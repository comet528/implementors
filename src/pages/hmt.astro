---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'hmt')).sort(
  byUpdatedDesc,
);
---

<BaseLayout
  title="HM Treasury"
  description="Consultation questions on agentic payments, consent, and liability."
>
  <h1>HM Treasury</h1>
  <p class="lede">
    Consultation questions on agentic payments, consent, and liability.
  </p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
