---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (await getCollection('cards', ({ data }) => data.family === 'fapi' || data.family === 'threat')).sort(
  byUpdatedDesc,
);
---

<BaseLayout
  title="How API security works"
  description="UK open banking still reads FAPI 1 Advanced. Do not treat FAPI 2 as the UK rulebook."
>
  <h1>How API security works</h1>
  <p class="lede">
    UK open banking still reads FAPI 1 Advanced. Do not treat FAPI 2 as the UK rulebook. A piece of
    software that pays is not the customer — that threat sits here too.
  </p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
