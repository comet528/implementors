---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { byUpdatedDesc } from '../lib/entries';

const entries = (
  await getCollection('cards', ({ data }) => data.family === 'fapi' || data.family === 'threat')
).sort(byUpdatedDesc);
---

<BaseLayout
  title="API security"
  description="FAPI profiles, OIDF conformance, AuthZEN/CoAZ, and related notes."
>
  <h1>API security</h1>
  <p class="lede">
    FAPI profiles, OIDF conformance, AuthZEN/CoAZ, and related notes. UK Open Banking v4 remains on
    FAPI 1 Advanced.
  </p>
  <EntryList entries={entries} collection="cards" />
</BaseLayout>
